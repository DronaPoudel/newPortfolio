{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development tsx index.ts",
        "build": "esbuild index.ts --platform=node --bundle --format=cjs --outfile=dist/index.cjs --external:express --external:pg",
        "start": "cross-env NODE_ENV=production node dist/index.cjs",
        "db:push": "drizzle-kit push"
    },
    "dependencies": {
        "@jridgewell/trace-mapping": "^0.3.25",
        "connect-pg-simple": "^10.0.0",
        "drizzle-orm": "^0.39.3",
        "drizzle-zod": "^0.7.0",
        "express": "^5.0.1",
        "express-session": "^1.18.1",
        "memorystore": "^1.6.7",
        "passport": "^0.7.0",
        "passport-local": "^1.0.0",
        "pg": "^8.16.3",
        "ws": "^8.18.0",
        "zod": "^3.24.2",
        "zod-validation-error": "^3.4.0"
    },
    "devDependencies": {
        "@types/connect-pg-simple": "^7.0.3",
        "@types/express": "^5.0.0",
        "@types/express-session": "^1.18.0",
        "@types/node": "20.19.27",
        "@types/passport": "^1.0.16",
        "@types/passport-local": "^1.0.38",
        "@types/ws": "^8.5.13",
        "cross-env": "^7.0.3",
        "drizzle-kit": "^0.31.8",
        "esbuild": "^0.25.0",
        "tsx": "^4.20.5",
        "typescript": "5.6.3"
    }
}